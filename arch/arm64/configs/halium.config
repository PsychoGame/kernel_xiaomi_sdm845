# halium.config — aanvullingen op de LineageOS-defconfig voor Ubuntu Touch.
#
# Plaatsen als:  arch/arm64/configs/halium.config
# Gebruiken via deviceinfo, NA de upstream-fragmenten:
#   deviceinfo_kernel_defconfig="vendor/xiaomi/mi845_defconfig vendor/xiaomi/beryllium.config halium.config"
#
# ===========================================================================
# HOE DIT BESTAND IS ONTSTAAN
# ===========================================================================
# Dit is niet gegokt. De officiele checker uit Halium/halium-boot is gedraaid
# tegen de echte kernelconfig van dit toestel (4.9.337-perf, uit /proc/config.gz):
#
#   ./check-kernel-config /pad/naar/running-kernel.config
#   -> "found 134 errors that I did not fix"
#
# Die 134 zijn hieronder uitgesplitst. BELANGRIJK: het script NIET met -w
# draaien. Het is oud en vraagt om symbolen die in een 4.9 arm64-kernel niet
# bestaan (zie sectie 6). Met -w zet het die er alsnog in: rommel in je
# defconfig, en het maakt een latere rebase onnodig lastig.
#
# Controleer na het bouwen altijd de echte .config, niet dit bestand:
#   ./check-kernel-config out/.config
# Alles wat dan nog "set it" of "unset it" zegt, is een bewuste keuze of een bug.

# ===========================================================================
# 1. De negen uit de UBports standalone-kernelroute
# ===========================================================================
# Gemeten: acht van de negen stonden UIT. Alleen NET_NS stond al aan.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y

# ===========================================================================
# 2. AppArmor: de kern van wat UT extra vraagt boven Halium
# ===========================================================================
# De lopende config heeft "# CONFIG_SECURITY_APPARMOR is not set" en
# CONFIG_DEFAULT_SECURITY_SELINUX=y. UT gebruikt AppArmor voor app-confinement.
# SELinux blijft ingecompileerd maar wordt niet de default, en moet via de
# cmdline uitgezet kunnen worden.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_UNCONFINED_INIT=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# SELinux blijft beschikbaar, maar uitzetbaar en niet default:
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_SECURITY_SELINUX_DISABLE=y
# Yama is onderdeel van de door UT verwachte stack:
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_YAMA_STACKED=y

# ===========================================================================
# 3. systemd: cgroups, audit, filesystems, keys
# ===========================================================================
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_TREE=y
CONFIG_AUDIT_WATCH=y
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
CONFIG_STRICT_DEVMEM=y
CONFIG_SYN_COOKIES=y
CONFIG_DNS_RESOLVER=y

# ===========================================================================
# 4. UITZETTEN — dit is waar het stuk kan gaan als je het overslaat
# ===========================================================================
# ANDROID_PARANOID_NETWORK beperkt het aanmaken van sockets tot bepaalde
# Android-GID's. Met Ubuntu-userspace op de host levert dat netwerkproblemen op
# die lastig te herleiden zijn. De checker zegt expliciet: uitzetten.
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# FW_LOADER_USER_HELPER is de verouderde udev-route voor firmware. Zonder
# helper in de UT-host blijft een firmwareverzoek hangen tot de timeout.
# Firmware wordt direct uit /vendor/firmware gelezen.
# LET OP: als je touchfirmware (novatek_nt36672_e10_hw0*.fw) niet laadt, is dit
# de eerste plek om te kijken.
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set

# RT_GROUP_SCHED botst met de manier waarop systemd cgroups indeelt.
# CONFIG_RT_GROUP_SCHED is not set

# CONFIG_XFRM_STATISTICS is not set

# De oude default-security moet weg, anders blijft SELinux de default:
# CONFIG_DEFAULT_SECURITY_SELINUX is not set

# ===========================================================================
# 4b. DE TELNET-RESCUE -- hier valt of staat je eerste boot
# ===========================================================================
# Bij een mislukte boot roept de initrd halium_panic aan en start de
# panic-handler scripts/panic/telnet. Die zet USB_FUNCTIONS=rndis en maakt in
# configfs de functies rndis.usb0 en rndis_bam.rndis aan, zet 192.168.2.15 op
# rndis0 en opent telnet op poort 23.
#
# In de LineageOS-config van dit toestel staan BEIDE rndis-functies UIT:
#   # CONFIG_USB_CONFIGFS_RNDIS is not set
#   # CONFIG_USB_CONFIGFS_QCRNDIS is not set
#
# Gevolg zonder deze regels: de mkdir mislukt, rndis0 komt niet op, usb0
# evenmin, en het script doet dan letterlijk:
#     usb_info "... could not setup USB as usb0 or rndis0"; dmesg; sleep 60; reboot -f
# Je toestel herstart dan na een minuut zonder netwerk, zonder adb en zonder
# zichtbare oorzaak -- terwijl de rescue juist je belangrijkste debug-ingang is.
CONFIG_USB_CONFIGFS_RNDIS=y

# Qualcomm-variant, levert rndis_bam.rndis. Het script maakt die ook aan.
# Komt rndis0 met alleen de regel hierboven niet op, zet dan ook deze aan.
# CONFIG_USB_CONFIGFS_QCRNDIS=y

# ===========================================================================
# 5. Netfilter en Bluetooth: compleetheid
# ===========================================================================
# Deze staan in de checker en zijn goedkoop. Zonder deze werkt het systeem
# meestal wel, maar missen onderdelen van firewall, tethering en BT-profielen.
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CLUSTER=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_NETFILTER_XT_MATCH_DEVGROUP=y
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_NETFILTER_XT_MATCH_OSF=y
CONFIG_NETFILTER_XT_MATCH_RATEEST=y
CONFIG_NETFILTER_XT_MATCH_REALM=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_AUDIT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_LED=y
CONFIG_NETFILTER_XT_TARGET_RATEEST=y
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y
CONFIG_IP6_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_EUI64=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_IP6_NF_MATCH_OPTS=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_IP6_NF_SECURITY=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# ===========================================================================
# 6. BEWUST OVERGESLAGEN uit de checker-uitvoer
# ===========================================================================
# Deze symbolen vraagt het script wel, maar ze bestaan niet (meer) in een
# 4.9 arm64-kernel of ze zijn al op een andere manier geregeld. Niet toevoegen:
#
#   CONFIG_CGROUP_MEM_RES_CTLR{,_SWAP,_KMEM}
#       Hernoemd naar MEMCG in 3.6. Deze tree heeft al CONFIG_MEMCG=y en
#       CONFIG_MEMCG_SWAP=y. Dus al in orde.
#   CONFIG_DEVPTS_MULTIPLE_INSTANCES
#       Verdwenen in 4.7; gedrag is sindsdien altijd aan.
#   CONFIG_RTC_DRV_CMOS
#       PC-RTC. Bestaat niet op dit toestel.
#   CONFIG_ARM_UNWIND
#       Alleen 32-bits ARM.
#   CONFIG_IP6_NF_QUEUE, CONFIG_IP6_NF_TARGET_REJECT_SKERR,
#   CONFIG_NETFILTER_TPROXY
#       Verouderd of opgegaan in andere symbolen. XT_TARGET_TPROXY staat al aan.
#   CONFIG_SPEAKUP, CONFIG_SUSPEND_TIME, CONFIG_FRAMEBUFFER_CONSOLE
#       Niet nodig voor deze port.
#   CONFIG_EVM, CONFIG_EVM_HMAC_VERSION, CONFIG_INTEGRITY_SIGNATURE
#       IMA/EVM. UT gebruikt dit niet.
#   CONFIG_SECURITY_TOMOYO en varianten
#       Andere LSM. Niet gebruiken.
#
# Dit is precies waarom -w niet gebruikt moet worden: het zou dit er allemaal
# bij zetten.

# ===========================================================================
# 7. Toestelspecifiek: staat AL in upstream, hier niet dupliceren
# ===========================================================================
# Deze module is hybride: Tianma NT36672A display + Focaltech touch op i2c-3
# adres 0x38. De device tree heeft zowel 3-0038 (Focaltech) als 3-0062
# (Novatek); degene die antwoordt wint.
#
# arch/arm64/configs/vendor/xiaomi/beryllium.config zet al
# CONFIG_TOUCHSCREEN_NT36XXX=y EN CONFIG_TOUCHSCREEN_FTS=y aan. Daarom staan ze
# hier niet nog eens: dubbel definieren geeft alleen "override: reassigning to
# symbol"-ruis.
#
# DE ENIGE REGEL DIE TELT: beryllium.config moet in deviceinfo_kernel_defconfig
# blijven staan. Valt dat fragment weg, dan verdwijnen beide touchdrivers.

# ===========================================================================
# 8. Bekend bouwrisico
# ===========================================================================
# mi845_defconfig heeft CONFIG_CC_WERROR=y: warnings zijn errors. Met een
# andere clang dan Google's exacte build kan de compilatie struikelen op
# warnings die niets met jouw wijzigingen te maken hebben. Dan tijdelijk:
# CONFIG_CC_WERROR is not set
